    ]
  },
  {
    "id": "on_off",
    "name": "On/Off",
    "importance": "medium",
    "rules": [
      { "condition": "state == \"on\"", "color": "#00FF00", "behavior": "solid" },
      { "condition": "default", "color": "#333333", "behavior": "solid" }
    ]
  },
  {
    "id": "unavailable_alert",
